import axiosInstance from "../interceptor/interceptor";

export interface Country {
  id: number;
  name: string;
  shortcut: string;
  is_active: boolean;
  created_at: string;
}

export interface CountryListResponse {
  items: Country[];
  total: number;
  pages: number;
}

// Overload — bez params zwraca Country[], z URLSearchParams zwraca paginowaną odpowiedź lub tablicę
export async function getCountries(): Promise<Country[]>;
export async function getCountries(params: URLSearchParams): Promise<CountryListResponse | Country[]>;
export async function getCountries(params?: URLSearchParams): Promise<CountryListResponse | Country[]> {
  if (params) {
    const response = await axiosInstance.get(`/api/address/countries?${params}`);
    return response.data;
  } else {
    const response = await axiosInstance.get("/api/address/countries");
    if (Array.isArray(response.data)) return response.data;
    if (response.data && Array.isArray(response.data.items)) return response.data.items;
    return [];
  }
}

export const addCountry = async (country: { name: string; shortcut: string }): Promise<void> => {
  await axiosInstance.post("/api/address/countries", country);
};

export const updateCountry = async (id: number, country: { name: string; shortcut: string }): Promise<void> => {
  await axiosInstance.put(`/api/address/countries/${id}`, country);
};

export const updateCountryStatus = async (id: number, is_active: boolean): Promise<void> => {
  await axiosInstance.patch(`/api/address/countries/${id}/status`, { is_active });
};

export const deleteCountry = async (id: number): Promise<void> => {
  await axiosInstance.delete(`/api/address/countries/${id}`);
};
