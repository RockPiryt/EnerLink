import axiosInstance from "../interceptor/interceptor";

export interface City {
  id: number;
  name: string;
  is_active: boolean;
  created_at: string;
  postal_code?: string;
  province?: string;
  country_id?: number;
}

export interface CityListResponse {
  items: City[];
  total: number;
  pages: number;
}

// Overloads — URLSearchParams zwraca paginowaną odpowiedź lub tablicę, obiekt zwraca tylko tablicę
export async function getCities(params: URLSearchParams): Promise<CityListResponse | City[]>;
export async function getCities(params?: { name?: string; postal_code?: string; country_id?: number }): Promise<City[]>;
export async function getCities(params?: URLSearchParams | { name?: string; postal_code?: string; country_id?: number }): Promise<CityListResponse | City[]> {
  let response;
  if (params instanceof URLSearchParams) {
    response = await axiosInstance.get(`/api/address/cities?${params}`);
    return response.data;
  } else {
    response = await axiosInstance.get("/api/address/cities", { params });
    if (Array.isArray(response.data)) return response.data;
    if (response.data && Array.isArray(response.data.items)) return response.data.items;
    return [];
  }
}

export const addCity = async (city: { name: string }): Promise<void> => {
  await axiosInstance.post("/api/address/cities", city);
};

export const updateCity = async (id: number, city: { name: string }): Promise<void> => {
  await axiosInstance.put(`/api/address/cities/${id}`, city);
};

export const toggleCityActive = async (id: number, is_active: boolean): Promise<void> => {
  await axiosInstance.put(`/api/address/cities/${id}`, { is_active });
};

export const deleteCity = async (id: number): Promise<void> => {
  await axiosInstance.delete(`/api/address/cities/${id}`);
};
